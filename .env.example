# M-Team
# 在 M-Team 控制台 -> 实验室/API 中获取存取令牌
MTEAM_API_KEY=
MTEAM_API_BASE=https://api.m-team.cc/api
# 站点域名，按你使用的域名填写，例如 https://kp.m-team.cc 或 https://ob.m-team.cc
MTEAM_SITE_URL=https://kp.m-team.cc
MTEAM_TIMEOUT=30
MTEAM_MAX_TORRENT_MB=32

# qBittorrent WebUI
QBITTORRENT_URL=http://127.0.0.1:8080
# 可选：通过 HTTP Basic Auth 访问 qBittorrent 或其反向代理，格式为 username:password。
# 设置后优先于 qBittorrent 内置的用户名/密码登录。
QBITTORRENT_BASIC_AUTH=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# 可选：固定保存路径；设置后会自动关闭自动 Torrent 管理（autoTMM）
QBITTORRENT_SAVE_PATH=
# 可选：分类名；不存在时服务会尝试自动创建
QBITTORRENT_CATEGORY=
# 可选：逗号分隔的标签
QBITTORRENT_TAGS=
QBITTORRENT_TIMEOUT=30

# 默认项；只有一个站点/下载器时可以留空
PT_DEFAULT_SITE=mteam
DOWNLOADER_DEFAULT=qbittorrent

# MCP 传输方式：stdio 或 streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
